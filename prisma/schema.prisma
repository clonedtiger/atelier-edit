datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String?
  name             String?
  sex              String?          // Male, Female, Other
  phone            String?
  height           String?
  weight           String?
  waistSize        String?
  braSize          String?          // Only visible/editable if female
  shoeSize         String?
  hatSize          String?
  gloveSize        String?
  clothingSize     String?
  workLife         String?          // Description of work/daily life
  inspirationNotes String?          // Inspirations list
  
  // Personalized Style DNA & Location
  styleAesthetic   String?          // e.g. "Minimalist Quiet Luxury", "Parisian Chic", "Contemporary Streetwear"
  favoriteBrands   String?          // e.g. "The Row, Toteme, Khaite, COS, Celine"
  avoidedStyles    String?          // e.g. "No neon, avoid loud logos, no synthetic leather"
  colorPalette     String?          // e.g. "Monochrome, ivory, camel, olive, charcoal"
  locationCity     String?          // e.g. "London", "Paris", "New York", "Milan"
  
  mfaEnabled       Boolean          @default(false)
  mfaSecret        String?          // TOTP secret key
  role             String           @default("user")
  suspended        Boolean          @default(false)
  passwordResetCode String?
  passwordResetExpires DateTime?

  // Marketing & GDPR Consent Preferences
  marketingEmail            Boolean          @default(false)
  marketingSms              Boolean          @default(false)
  marketingPartners         Boolean          @default(false)
  marketingConsentUpdatedAt DateTime?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  wardrobeItems     WardrobeItem[]
  recommendations   Recommendation[]
  sessions          UserSession[]
  activities        UsageActivity[]
  inspirations      InspirationImage[]
  feedSubscriptions UserFeedSubscription[]
  customFeeds       FeedSource[]
  capsules          CapsuleTrip[]
  collages          OutfitCollage[]

  @@index([role])
}

model WardrobeItem {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl    String   // Path or URL to compressed WebP image
  category    String   // e.g. "Outerwear", "Tops", "Bottoms", "Shoes", "Accessories"
  color       String[] // Extracted color palette (stored as string array)
  brand       String?
  styleNotes  String?  // Description of cut, fabric, texture
  detectedTags String[] // e.g. ["tweed", "structural", "asymmetric"]
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, category])
}

model FeedSource {
  id            String   @id @default(uuid())
  name          String
  url           String   @unique
  type          String   // "rss" | "youtube" | "substack" | "instagram"
  category      String?  // "Luxury & Haute Couture" | "Streetwear & Contemporary" | "Minimalism" | "Editorial Substacks"
  userId        String?  // null for curated starter feeds, or user id for custom feeds
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isMuted       Boolean  @default(false)
  createdAt     DateTime @default(now())
  subscriptions UserFeedSubscription[]

  @@index([isMuted])
  @@index([userId])
  @@index([category])
}

model UserFeedSubscription {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedSourceId String
  feedSource   FeedSource @relation(fields: [feedSourceId], references: [id], onDelete: Cascade)
  isMuted      Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([userId, feedSourceId])
  @@index([userId])
  @@index([feedSourceId])
}

model TrendArticle {
  id          String   @id @default(uuid())
  sourceUrl   String   @unique
  sourceName  String
  title       String
  content     String   // Clean text extracted from feed
  publishedAt DateTime
  extractedTrends String[] // e.g. ["boucle jackets", "oversized leather"]
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([sourceName])
}

model Recommendation {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   // e.g. "Classic Chanel meets McQueen Grunge"
  narrative   String   // Text explanation of the outfit styling choices
  createdAt   DateTime @default(now())
  outfitItems RecommendationItem[]

  @@index([userId, createdAt])
}

model RecommendationItem {
  id               String   @id @default(uuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  
  // Either links to a wardrobe item, or recommends a new purchase item
  wardrobeItemId   String?
  
  // For new purchase recommendations
  purchaseName     String?
  purchaseBrand    String?
  purchaseUrl      String?
  purchaseImageUrl String?
  priceEstimate    String?
  stylingRationale String   // Why this item is paired

  @@index([recommendationId])
  @@index([wardrobeItemId])
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginTime  DateTime @default(now())
  lastActive DateTime @default(now())
  duration   Int?     // duration in seconds

  @@index([userId, lastActive])
}

model UsageActivity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // "LOGIN" | "UPLOAD_IMAGE" | "GENERATE_OUTFIT"
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

model InspirationImage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl  String   // Path or URL to compressed WebP image
  notes     String?  // Summary of the style aesthetic / textures / vibe
  tags      String[] // Aesthetic keywords / tags
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model CapsuleTrip {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination     String   // e.g. "Paris, France"
  startDate       DateTime
  endDate         DateTime
  tripPurpose     String   // "Business & Dinners", "Weekend Getaway", "Fashion Week"
  luggageType     String   // "Carry-on Only", "Checked Suitcase"
  itemIds         String[] // Array of selected wardrobe item UUIDs
  outfitSchedule  Json     // Day-by-day day & evening outfit itineraries
  checklistNotes  String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model OutfitCollage {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String   // e.g. "Autumn Rain in Mayfair"
  canvasData   Json     // Placed elements: [{ id, imageUrl, x, y, scale, rotation, zIndex, label }]
  thumbnailUrl String?  // Rendered composite image
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

